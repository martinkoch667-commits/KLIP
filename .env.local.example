# Supabase — récupérez ces valeurs dans Settings > API de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Meta Pixel — ID du pixel (Events Manager > Sources de données). Un ID par défaut
# est déjà câblé dans le code ; cette variable le remplace si définie.
# NEXT_PUBLIC_FB_PIXEL_ID=000000000000000

# Meta Conversions API (CAPI) — suivi serveur (Lead), plus fiable que le pixel seul
# (résiste aux adblockers). SECRET. Events Manager > Paramètres > API de conversions
# > Générer un token d'accès. Sans lui, la CAPI reste désactivée (le pixel suffit).
# META_CAPI_TOKEN=

# IA par défaut = Gemini (bon marché). REQUIS pour la génération de légendes,
# "Composer (IA)", "Vérifier", et tous les outils IA quand l'utilisateur n'a PAS
# connecté sa propre clé Claude (BYOK). Sans elle, ces fonctions plantent.
# Clé gratuite : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# BYOK Claude — clé de chiffrement serveur pour les clés Anthropic perso des utilisateurs.
# Générer avec : openssl rand -hex 32 — jamais NEXT_PUBLIC_, jamais commit.
# BYOK_ENCRYPTION_KEY=
